# Required: an OpenAI-compatible chat provider.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings may use a different OpenAI-compatible endpoint and key.
# Leave EMBEDDING_API_KEY unset to reuse OPENAI_API_KEY.
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
QDRANT_URL=http://localhost:6333

# Optional MinerU HTTP API for conversation attachments.
MINERU_API_ENABLED=false
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_MODEL_VERSION=vlm

# Prior-task memory is optional; ordinary source retrieval works without it.
TASK_MEMORY_ENABLED=false
# HILO_CONFIG_PATH=/absolute/path/to/config.yaml
# HILO_HOME=/absolute/path/to/runtime-data
